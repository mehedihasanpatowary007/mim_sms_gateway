<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sms_gateway" model="ir.module.category">
        <field name="name">SMS Gateway</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_sms_gateway" model="res.groups.privilege">
        <field name="name">SMS Gateway</field>
        <field name="category_id" ref="module_category_sms_gateway"/>
        <field name="description">Control access to SMS sending and gateway configuration.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_sms_gateway_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_sms_gateway"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_sms_gateway_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_sms_gateway"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_sms_gateway_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sms_history_allowed_companies" model="ir.rule">
        <field name="name">SMS history: allowed companies</field>
        <field name="model_id" ref="model_sms_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sms_gateway_user'))]"/>
    </record>

    <record id="rule_sms_queue_allowed_companies" model="ir.rule">
        <field name="name">SMS queue: allowed companies</field>
        <field name="model_id" ref="model_sms_queue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sms_gateway_user'))]"/>
    </record>

    <record id="rule_sms_template_allowed_companies" model="ir.rule">
        <field name="name">SMS templates: allowed companies</field>
        <field name="model_id" ref="model_mimsms_template"/>
        <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sms_gateway_user'))]"/>
    </record>
</odoo>
