<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sms_template_list" model="ir.ui.view">
        <field name="name">mimsms.template.list</field>
        <field name="model">mimsms.template</field>
        <field name="arch" type="xml">
            <list string="SMS Templates" decoration-muted="not active">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="template_type"/>
                <field name="model_id"/>
                <field name="usage_count" optional="show"/>
                <field name="last_used" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sms_template_form" model="ir.ui.view">
        <field name="name">mimsms.template.form</field>
        <field name="model">mimsms.template</field>
        <field name="arch" type="xml">
            <form string="SMS Template">
                <header>
                    <button name="action_test_template" string="Test Template"
                            type="object" icon="fa-flask" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="template_type"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="model" invisible="1"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="usage_count" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="message">
                            <field name="body" widget="text" nolabel="1"
                                   placeholder="Dear {{partner_id.name}}, your message..."/>
                        </page>
                        <page string="Preview" name="preview">
                            <field name="sample_preview" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sms_template_search" model="ir.ui.view">
        <field name="name">mimsms.template.search</field>
        <field name="model">mimsms.template</field>
        <field name="arch" type="xml">
            <search string="SMS Templates">
                <field name="name"/>
                <field name="company_id"/>
                <field name="template_type"/>
                <field name="model_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_purpose" string="Purpose" context="{'group_by': 'template_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sms_template" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">mimsms.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sms_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
