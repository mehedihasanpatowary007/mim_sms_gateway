<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mimsms_gateway.ChatterSendSms"
       t-inherit="mail.Chatter"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="after">
            <button t-if="smsGateway.available and props.threadId"
                    type="button"
                    class="btn btn-secondary text-nowrap ms-1 o_mimsms_chatter_button"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    t-att-disabled="smsGateway.opening"
                    t-on-click="onMimsmsSendSms"
                    title="Send SMS"
                    aria-label="Send SMS">
                <i t-att-class="smsGateway.opening ? 'fa fa-spinner fa-spin me-1' : 'fa fa-mobile me-1'"/>
                <span t-esc="smsGateway.opening ? 'Opening...' : 'Send SMS'"/>
            </button>
        </xpath>
    </t>
</templates>
