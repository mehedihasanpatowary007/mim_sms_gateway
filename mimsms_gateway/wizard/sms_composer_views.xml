<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sms_composer_form" model="ir.ui.view">
        <field name="name">sms.composer.form</field>
        <field name="model">mimsms.composer</field>
        <field name="arch" type="xml">
            <form string="Send SMS" class="o_mimsms_composer">
                <sheet>
                    <group>
                        <group>
                            <field name="is_chatter_single" invisible="1"/>
                            <field name="is_single_partner" invisible="1"/>
                            <field name="manager_recipient_available" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="composition_mode1"
                                   widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="is_chatter_single"/>
                            <field name="template_id" 
                                   string="SMS Template"
                                   options="{'no_create': True}"
                                   domain="[('model', '=', res_model)]"
                                   invisible="not is_chatter_single and composition_mode1 != 'template'"
                                   placeholder="Select a template"/>
                        </group>
                        <group>
                            <field name="res_model" invisible="1"/>
                            <field name="res_ids" invisible="1"/>
                            <field name="recipient_count" readonly="1" class="o_mimsms_recipient_count"/>
                        </group>
                    </group>

                    <group string="Recipients" invisible="not is_single_partner">
                        <group string="Partner">
                            <field name="send_to_partner"/>
                            <field name="partner_recipient_name" readonly="1"/>
                            <field name="partner_recipient_mobile" readonly="1"/>
                        </group>
                        <group string="Manager">
                            <field name="send_to_manager"
                                   readonly="not manager_recipient_available"/>
                            <field name="manager_recipient_name"
                                   readonly="1"
                                   invisible="not manager_recipient_available"/>
                            <field name="manager_recipient_mobile"
                                   readonly="1"
                                   invisible="not manager_recipient_available"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Message" name="message">
                            <field name="message" 
                                   widget="text" 
                                   placeholder="Type your SMS message here..."
                                   nolabel="1"
                                   required="1"/>
                            <group class="mt-2">
                                <group>
                                    <field name="character_count" readonly="1"/>
                                    <field name="sms_parts" readonly="1"/>
                                </group>
                                <group>
                                    <field name="sms_encoding" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Recipients" name="recipients"
                              invisible="is_single_partner">
                            <field name="recipient_info" 
                                   widget="text" 
                                   readonly="1"
                                   nolabel="1"
                                   placeholder="No recipients with valid mobile numbers found"/>
                        </page>
                        
                        <page string="Preview" name="preview">
                            <group>
                                <field name="preview_mobile" readonly="1"/>
                            </group>
                            <field name="preview_message" 
                                   widget="text" 
                                   readonly="1"
                                   nolabel="1"
                                   placeholder="Preview will be shown here"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Send SMS" 
                            name="action_send_sms" 
                            type="object" 
                            class="btn-primary o_mimsms_send_button"
                            data-hotkey="s"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
