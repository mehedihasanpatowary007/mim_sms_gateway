<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mimsms_config_form" model="ir.ui.view">
        <field name="name">mimsms.config.form</field>
        <field name="model">mimsms.config</field>
        <field name="arch" type="xml">
            <form string="MiMSMS Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" 
                                type="object" 
                                name="action_check_balance" 
                                icon="fa-money">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    BDT <field name="balance" nolabel="1"/>
                                </span>
                                <span class="o_stat_text">Balance</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="username" class="oe_edit_only"/>
                        <h1>
                            <field name="username" placeholder="your-email@example.com"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="API Credentials">
                            <field name="apikey" password="True"/>
                            <field name="sender_id"/>
                            <field name="base_url"/>
                        </group>
                        <group string="Status">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Leave empty for all companies"/>
                            <field name="last_balance_check" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Automation">
                        <group string="Automatic Messages">
                            <field name="payment_sms_enabled" widget="boolean_toggle"/>
                            <field name="overdue_sms_enabled" widget="boolean_toggle"/>
                            <field name="monthly_sms_enabled" widget="boolean_toggle"/>
                        </group>
                        <group string="Delivery Controls">
                            <field name="retry_delay_minutes"/>
                            <field name="max_sms_parts"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mimsms_config_list" model="ir.ui.view">
        <field name="name">mimsms.config.list</field>
        <field name="model">mimsms.config</field>
        <field name="arch" type="xml">
            <list string="MiMSMS Configurations" 
                  decoration-muted="not active">
                <field name="username"/>
                <field name="sender_id"/>
                <field name="balance"/>
                <field name="last_balance_check" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_mimsms_config" model="ir.actions.act_window">
        <field name="name">MiMSMS Configuration</field>
        <field name="res_model">mimsms.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
