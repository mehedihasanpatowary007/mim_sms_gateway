<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sms_gateway" model="ir.ui.view">
        <field name="name">account.move.form.sms.gateway</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_invoice_sms"
                        string="Send SMS"
                        type="object"
                        icon="fa-mobile"
                        groups="mimsms_gateway.group_sms_gateway_user"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
