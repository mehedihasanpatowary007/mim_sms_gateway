<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_sms_gateway" model="ir.ui.view">
        <field name="name">stock.picking.form.sms.gateway</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_delivery_sms"
                        string="Send SMS"
                        type="object"
                        icon="fa-mobile"
                        groups="mimsms_gateway.group_sms_gateway_user"
                        invisible="picking_type_code != 'outgoing'"/>
            </xpath>
        </field>
    </record>
</odoo>
