<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove templates from the retired Contact/CRM flows on module upgrade. -->
    <delete model="mimsms.template"
            search="[('name', 'in', ['Welcome Message - Contact', 'Follow-up Message - Contact', 'Birthday Wishes - Contact', 'Thank You Message - Contact', 'Welcome Message - Lead', 'Follow-up - Lead', 'Meeting Reminder - Lead', 'Opportunity Won - Lead', 'Quotation Sent - Lead', 'Promotional Offer - Lead'])]"/>

    <data noupdate="1">
        <record id="sms_template_invoice_generated" model="mimsms.template">
            <field name="name">Invoice Generated</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="template_type">invoice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="body">Dear ${object.partner_id.name}, your Invoice ${object.name} for BDT ${object.amount_total} has been generated. Due Date: ${object.invoice_date_due}.
Bridge Chemie</field>
        </record>

        <record id="sms_template_payment_received" model="mimsms.template">
            <field name="name">Payment Received</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="template_type">payment</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="body">Dear ${object.partner_id.name}, we have received your payment of BDT ${object.amount} successfully. Ref: ${object.name}.
Bridge Chemie</field>
        </record>

        <record id="sms_template_delivery" model="mimsms.template">
            <field name="name">Customer Delivery</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="template_type">delivery</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="body">Dear ${object.partner_id.name}, your Delivery ${object.name} against Order ${object.origin} is ready for dispatch.
Bridge Chemie</field>
        </record>

        <record id="sms_template_invoice_overdue" model="mimsms.template">
            <field name="name">Invoice Overdue</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="template_type">overdue</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="body">Dear ${object.partner_id.name}, payment of BDT ${object.amount_residual} for Invoice ${object.name} was due on ${object.invoice_date_due} and is now overdue. Please arrange payment at your earliest convenience.
Bridge Chemie</field>
        </record>

        <record id="sms_template_monthly_closing" model="mimsms.template">
            <field name="name">Monthly Due</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="template_type">monthly</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="body">Dear ${object.partner_name}, your account summary for ${object.month_name}: Opening Outstanding: BDT ${object.opening_outstanding}, Invoice Amount: BDT ${object.monthly_invoice_amount}, Payment Received: BDT ${object.monthly_payment}, Closing Outstanding: BDT ${object.closing_outstanding}.
Bridge Chemie</field>
        </record>

        <record id="ir_cron_sms_invoice_overdue" model="ir.cron">
            <field name="name">SMS: Send Invoice Overdue Notices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_sms()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_sms_monthly_closing" model="ir.cron">
            <field name="name">SMS: Send Monthly Closing Statements</field>
            <field name="model_id" ref="model_sms_automation"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_monthly_closing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_sms_queue_processor" model="ir.cron">
            <field name="name">SMS: Process Bulk Queue</field>
            <field name="model_id" ref="model_sms_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>

    <function model="mimsms.template" name="ensure_company_templates"/>
</odoo>
